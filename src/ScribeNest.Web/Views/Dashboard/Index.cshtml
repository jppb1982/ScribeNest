@model ScribeNest.Web.Models.DashboardVm
@{
    ViewData["Title"] = "Dashboard";
    var maxCategory = Math.Max(1, Model.PostsByCategory.Any() ? Model.PostsByCategory.Max(x => x.Count) : 1);
    var maxTag = Math.Max(1, Model.TopTags.Any() ? Model.TopTags.Max(x => x.Count) : 1);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <p class="eyebrow mb-1">Admin overview</p>
        <h1 class="mb-0">Dashboard</h1>
        <p class="text-muted mb-0">Métricas simples para conectar producto, contenido y análisis de datos.</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" asp-controller="Posts" asp-action="Index">Gestionar posts</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4"><div class="metric-card dashboard-metric"><span class="metric-value">@Model.TotalPosts</span><span class="metric-label">Posts publicados</span></div></div>
    <div class="col-md-4"><div class="metric-card dashboard-metric"><span class="metric-value">@Model.TotalCategories</span><span class="metric-label">Categorías activas</span></div></div>
    <div class="col-md-4"><div class="metric-card dashboard-metric"><span class="metric-value">@Model.TopTags.Count</span><span class="metric-label">Tags únicos</span></div></div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="panel-card h-100">
            <h2 class="h5 mb-3">Últimos posts</h2>
            @if (!Model.LatestPosts.Any())
            {
                <div class="empty-state compact">Todavía no hay posts publicados.</div>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var post in Model.LatestPosts)
                    {
                        <a class="list-group-item list-group-item-action px-0" asp-controller="Posts" asp-action="Details" asp-route-slug="@post.Slug">
                            <div class="d-flex justify-content-between gap-3">
                                <strong>@post.Title</strong>
                                <small class="text-muted text-nowrap">@post.PublishedAt.ToLocalTime().ToString("dd/MM")</small>
                            </div>
                            <small class="text-muted">@post.Category · @post.ReadingMinutes min</small>
                        </a>
                    }
                </div>
            }
        </div>
    </div>
    <div class="col-lg-5">
        <div class="panel-card h-100">
            <h2 class="h5 mb-3">Posts por categoría</h2>
            @foreach (var item in Model.PostsByCategory)
            {
                var width = Math.Round(item.Count * 100d / maxCategory);
                <div class="chart-row">
                    <div class="d-flex justify-content-between"><span>@item.Category</span><strong>@item.Count</strong></div>
                    <div class="chart-track"><div class="chart-bar" style="width:@width%"></div></div>
                </div>
            }
        </div>
    </div>
</div>

<div class="panel-card mt-4">
    <h2 class="h5 mb-3">Tags más usados</h2>
    @if (!Model.TopTags.Any())
    {
        <div class="empty-state compact">Todavía no hay tags cargados.</div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var item in Model.TopTags)
            {
                var width = Math.Round(item.Count * 100d / maxTag);
                <div class="col-md-6">
                    <div class="chart-row">
                        <div class="d-flex justify-content-between"><span>@item.Tag</span><strong>@item.Count</strong></div>
                        <div class="chart-track"><div class="chart-bar accent" style="width:@width%"></div></div>
                    </div>
                </div>
            }
        </div>
    }
</div>
